ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# AI provider: 'anthropic' | 'gemini' | 'groq' | 'both'
# 'both' uses Anthropic as primary and falls back to Gemini if Anthropic fails
AI_PROVIDER=anthropic

PORT=3001
# Your production domain (used for canonical URLs and OG tags in share pages)
SITE_URL=https://briefwise.online
# Comma-separated list of allowed CORS origins (defaults to localhost:5173/5174 in dev)
# ALLOWED_ORIGINS=https://briefwise.online

# Upstash Redis (for persistent usage tracking)
# Get free credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# MongoDB (for share links and analytics)
# Get free cluster at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/briefwise
